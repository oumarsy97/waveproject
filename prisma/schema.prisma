model Operateur {
  id          Int      @id @default(autoincrement())
  nom         String
  prenom      String
  addresse    String
  idCompte    Int
  compte    Compte   @relation(fields: [idCompte], references: [id])
  tauxCommission Float @default(0.02)
  transactions Transaction[] @relation("ClientReceivedTransferts")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Transaction {
  id          Int      @id @default(autoincrement())
  montant     Int
  idOperateur Int? 
  idClient    Int
  idEmeteur   Int?
  emeteur     Compte?   @relation("ClientSentTransfert", fields: [idEmeteur], references: [id])
  reference   String   @unique
  statut      StatutTransaction @default(EN_ATTENTE)
  type        Type    @default(DEPOT)
  frais       Int     @default(0)
  compte      Compte   @relation("ClientSentTransferts", fields: [idClient], references: [id])
  operateur   Operateur? @relation("ClientReceivedTransferts", fields: [idOperateur], references: [id])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model trasfertprogramme {
  id        Int      @id @default(autoincrement())
  montant   Int
  idEmeteur  Int
  idRecepteur Int
  emmeteur    Compte   @relation("ClientSentTransferts", fields: [idEmeteur], references: [id])
  recepteur   Compte @relation("ClientReceivedTransferts", fields: [idRecepteur], references: [id])
  statut    statusProgramme @default(EN_ATTENTE)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  dateExecution DateTime
}

enum typeProgramme {
JOURNALIERE
HEBDOMODAIRE
MENSUELLE 
}

model TransfertRecurrent {
  id           Int      @id @default(autoincrement())
  montant      Int
  idEmeteur    Int
  idRecepteur  Int
  jourDuMois   Int      // jour d'exécution (1-31)
  heure        Int      // heure d'exécution (0-23)
  minute       Int      // minute d'exécution (0-59)
  type         typeProgramme @default(JOURNALIERE)
  statut       String   @default("ACTIF") // ACTIF, SUSPENDU, TERMINE
  emmeteur     Compte   @relation("ClientSentRecurrents", fields: [idEmeteur], references: [id])
  recepteur    Compte   @relation("ClientReceivedRecurrents", fields: [idRecepteur], references: [id])
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  dernierExecutionDate DateTime?
  prochainExecutionDate DateTime
}

model Credit {
  id        Int      @id @default(autoincrement())
  montant   Int
  idClient  Int
  telephone String   
  statut    StatutTransaction @default(EN_ATTENTE)
  reference String   @unique
  client    Client   @relation("ClientSentTransferts", fields: [idClient], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  
}

model Notification {
  id        Int      @id @default(autoincrement())
  clientId  Int
  client    Client   @relation(fields: [clientId], references: [id])
  titre     String
  message   String
  type      TypeNotification
  estLue    Boolean  @default(false)
  createdAt DateTime @default(now())
}
